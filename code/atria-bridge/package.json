{
  "name": "atria-bridge",
  "displayName": "Atria Bridge",
  "description": "Liga o VS Code ao Atria OS: abre a nota escolhida no painel e informa qual arquivo está aberto.",
  "version": "0.1.0",
  "publisher": "atria",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  }
}