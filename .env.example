YUI_DOMAIN=yui.eliveutonsouza.cloud
YUI_USER_NAME=Eliveuton
# hash argon2id da senha de login: node -e "require('@node-rs/argon2').hash(process.argv[1]).then(console.log)" 'senha'
YUI_PASSWORD_HASH=
SESSION_SECRET=
# OpenAI: GPT-Live-1 (voz) + cérebro (Responses). Chave de API — não usa o plano do ChatGPT.
OPENAI_API_KEY=
YUI_LIVE_MODEL=gpt-live-1
YUI_BRAIN_MODEL=gpt-6-luna
YUI_VOICE=marin
YUI_LIVE_IDLE_MIN=5
# Claude Code (assinatura): gere com `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
YUI_CLAUDE_MODEL=
YUI_MAX_CONCURRENT_RUNS=2
# GitHub: preferível `docker exec -it yui-console-yui-console-1 gh auth login` (cobre usuário + orgs).
# Alternativa: token clássico (repo, workflow, read:org). Fine-grained cobre só um dono.
# GH_TOKEN=
YUI_PLANNER_MODEL=gpt-6-sol

# Push (PWA): chaves VAPID são geradas no primeiro boot e guardadas no banco; opcional definir o remetente
# VAPID_SUBJECT=mailto:eliveuton.dev@gmail.com
