# Yui Console — configuração da instalação.
# O ./install.sh preenche este arquivo. Quase tudo também pode ser ajustado depois no painel
# (Configurações), que tem prioridade sobre os valores daqui.

# ── Obrigatório ─────────────────────────────────────────────────────────
# Domínio do painel (o DNS precisa apontar para esta VPS).
YUI_DOMAIN=yui.example.com
# E-mail para os certificados HTTPS (Let's Encrypt).
ACME_EMAIL=
# Segredo das sessões — o install.sh gera um aleatório.
SESSION_SECRET=
# Base de conhecimento da Empresa (gerados pelo install.sh)
YUI_PG_PASSWORD=
YUI_QDRANT_KEY=

# ── Proxy HTTPS ─────────────────────────────────────────────────────────
# auto = usa um Traefik que já esteja rodando na VPS; senão sobe o Caddy (COMPOSE_PROFILES=edge).
YUI_PROXY=auto
# Só com Traefik existente: nomes do entrypoint HTTPS e do resolver ACME dele.
# YUI_TRAEFIK_ENTRYPOINT=websecure
# YUI_TRAEFIK_CERTRESOLVER=letsencrypt

# ── OpenAI (voz e cérebro da Yui) ───────────────────────────────────────
# Chave de API da plataforma OpenAI (platform.openai.com) — o plano ChatGPT não serve.
# Pode ficar vazia aqui e ser colada no painel em Configurações › Conexões.
OPENAI_API_KEY=
# YUI_LIVE_MODEL=gpt-live-1
# YUI_BRAIN_MODEL=gpt-6-luna
# YUI_PLANNER_MODEL=gpt-6-sol
# YUI_VOICE=marin
# YUI_LIVE_IDLE_MIN=5

# ── Acesso ao painel ────────────────────────────────────────────────────
# Vazio = o primeiro acesso pelo navegador cria a senha (recomendado).
YUI_PASSWORD_HASH=
# Seu nome (a Yui te chama assim) — também editável no painel.
YUI_USER_NAME=

# ── Claude ──────────────────────────────────────────────────────────────
# Recomendado: conectar a conta Claude pelo painel (Configurações › Conexões › Conectar conta Claude),
# que traz conectores MCP, skills e plugins da sua conta.
# Alternativa sem conectores: token de `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=
# YUI_CLAUDE_MODEL=
# YUI_MAX_CONCURRENT_RUNS=2

# ── GitHub (opcional) ───────────────────────────────────────────────────
# Recomendado: conectar pelo painel (Configurações › Conexões › Conectar GitHub).
# Alternativa: token clássico com escopos repo, workflow, read:org.
# GH_TOKEN=

# ── Notificações push (PWA) ─────────────────────────────────────────────
# Chaves VAPID são geradas no primeiro boot. Remetente opcional:
# VAPID_SUBJECT=mailto:voce@exemplo.com
