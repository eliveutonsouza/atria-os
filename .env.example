# Atria OS — configuração da instalação.
# O ./install.sh preenche este arquivo. Quase tudo também pode ser ajustado depois no painel
# (Configurações), que tem prioridade sobre os valores daqui.

# ── Obrigatório ─────────────────────────────────────────────────────────
# Domínio do painel (o DNS precisa apontar para esta VPS).
ATRIA_DOMAIN=atria.example.com
# E-mail para os certificados HTTPS (Let's Encrypt).
ACME_EMAIL=
# Segredo das sessões — o install.sh gera um aleatório.
SESSION_SECRET=
# Base de conhecimento da Empresa (gerados pelo install.sh)
ATRIA_PG_PASSWORD=
ATRIA_QDRANT_KEY=
# Fuso horário (hora da Yui, agendamentos, lembretes). O install.sh pergunta; padrão = fuso da VPS.
TZ=America/Sao_Paulo

# ── Proxy HTTPS ─────────────────────────────────────────────────────────
# auto    = usa um Traefik que já esteja rodando na VPS; senão sobe o Caddy.
# caddy   = sobe o Caddy em :80/:443 com certificado automático (COMPOSE_PROFILES=edge).
# traefik = usa o Traefik existente pelas labels do serviço atria.
# none    = sem HTTPS próprio: publica 127.0.0.1:ATRIA_HTTP_PORT para o seu proxy (nginx, Cloudflare Tunnel…).
ATRIA_PROXY=auto
# Só com Traefik existente: nomes do entrypoint HTTPS e do resolver ACME dele.
# ATRIA_TRAEFIK_ENTRYPOINT=websecure
# ATRIA_TRAEFIK_CERTRESOLVER=letsencrypt
# Só com ATRIA_PROXY=none (o install.sh grava COMPOSE_FILE e ATRIA_TRAEFIK_ENABLE=false):
# ATRIA_HTTP_PORT=8080
# ATRIA_BIND=127.0.0.1
# Nome do projeto Docker. Mude só para uma segunda instalação isolada na mesma VPS.
# ATRIA_PROJECT=atria-os
# Só com Traefik: domínio antigo que deve redirecionar (308) para ATRIA_DOMAIN (o install.sh liga o docker-compose.redirect.yml).
# ATRIA_OLD_DOMAIN=

# ── OpenAI (voz e cérebro da Yui) ───────────────────────────────────────
# Chave de API da plataforma OpenAI (platform.openai.com) — o plano ChatGPT não serve.
# Pode ficar vazia aqui e ser colada no painel em Configurações › Conexões.
OPENAI_API_KEY=
# ATRIA_LIVE_MODEL=gpt-live-1
# ATRIA_BRAIN_MODEL=gpt-6-luna
# ATRIA_PLANNER_MODEL=gpt-6-sol
# ATRIA_VOICE=marin
# ATRIA_LIVE_IDLE_MIN=5

# ── Monitoramento remoto (opcional) ─────────────────────────────────────
# Atria Central do administrador: endereço (https) e a chave atk_… (ou ymk_… antiga) gerada ao cadastrar esta instalação.
# Com os dois preenchidos o pulso liga sozinho; dá para ligar/desligar em Configurações › Sistema.
# ATRIA_MONITOR_URL=https://central.seudominio.com
# ATRIA_MONITOR_KEY=
# ATRIA_MONITOR_ENABLED=true

# ── Versão e atualização remota (instalação por imagem) ─────────────────
# Preenchidos pelo deploy/install-release.sh (comando "instalar em 1 comando" do Atria Central).
# Instalação a partir do código (install.sh) não usa: builda aqui (COMPOSE_FILE com docker-compose.build.yml).
# ATRIA_TAG=v1.0.0                # versão das imagens; o atualizador troca este valor
# GHCR_USER=                      # conta e token (read:packages) para baixar as imagens privadas do ghcr.io
# GHCR_TOKEN=
# ATRIA_UPDATER_TOKEN=            # token interno entre o Atria OS e o atria-updater (aleatório)
# ATRIA_STACK_DIR=/opt/atria-os   # caminho ABSOLUTO desta pasta no host (o atualizador monta no mesmo caminho)
# ATRIA_REGISTRY=ghcr.io/eliveutonsouza
# COMPOSE_PROFILES=updater        # liga o atualizador (edge,updater no modo caddy)

# ── Acesso ao painel ────────────────────────────────────────────────────
# Vazio = o primeiro acesso pelo navegador cria a senha (recomendado).
ATRIA_PASSWORD_HASH=
# Seu nome (a Yui te chama assim) — também editável no painel.
ATRIA_USER_NAME=
# Sua cidade (clima e feriados da Yui), ex.: "Goiânia, GO" — também editável no painel.
# ATRIA_USER_CITY=
# Seu e-mail (remetente das notificações push) — também editável no painel.
# ATRIA_USER_EMAIL=

# ── Claude ──────────────────────────────────────────────────────────────
# Recomendado: conectar a conta Claude pelo painel (Configurações › Conexões › Conectar conta Claude),
# que traz conectores MCP, skills e plugins da sua conta.
# Alternativa sem conectores: token de `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=
# ATRIA_CLAUDE_MODEL=
# ATRIA_MAX_CONCURRENT_RUNS=2

# ── GitHub (opcional) ───────────────────────────────────────────────────
# Recomendado: conectar pelo painel (Configurações › Conexões › Conectar GitHub).
# Alternativa: token clássico com escopos repo, workflow, read:org.
# GH_TOKEN=

# ── Notificações push (PWA) ─────────────────────────────────────────────
# Chaves VAPID são geradas no primeiro boot. Remetente opcional:
# VAPID_SUBJECT=mailto:voce@exemplo.com
